# Database
MONGODB_URI=

# Auth (use a long random value, at least 16 characters)
JWT_SECRET=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PORT=4000

# Email (OTP verification and password reset)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# AI provider: gemini (default), huggingface or ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
HF_API_TOKEN=
HF_MODEL_URL=
OLLAMA_API_URL=
OLLAMA_MODEL=

# Code execution. Choose a provider; if EXECUTION_PROVIDER is empty the first configured one is used.
# With no working provider, code execution is reported as unavailable and nothing is scored (never fake output).
# See infra/judge0/README.md for a local sandbox and hosted options.
EXECUTION_PROVIDER=
# Judge0 (self-hosted, judge0.com, or RapidAPI). Local example: http://127.0.0.1:2358
JUDGE0_URL=
# RapidAPI key or judge0.com auth token (optional for self-hosted)
JUDGE0_API_KEY=
# Only for RapidAPI, for example judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=
# Optional JSON override of Judge0 language ids, for example {"python":92}
JUDGE0_LANGUAGE_IDS=
# Backup provider: JDoodle
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Speech to text (AssemblyAI). If unset, transcription is reported as not configured.
ASSEMBLYAI_API_KEY=
