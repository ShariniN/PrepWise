# Database
MONGODB_URI=

# Auth (use a long random value, at least 16 characters)
JWT_SECRET=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PORT=4000

# Email (OTP verification and password reset)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# AI provider: gemini (default), huggingface or ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=
HF_API_TOKEN=
HF_MODEL_URL=
OLLAMA_API_URL=
OLLAMA_MODEL=

# Code execution (JDoodle). If unset, code execution is reported as unavailable.
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Speech to text (AssemblyAI). If unset, transcription is reported as not configured.
ASSEMBLYAI_API_KEY=
