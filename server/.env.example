# Database
MONGODB_URI=

# Auth (use a long random value, at least 16 characters)
JWT_SECRET=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
PORT=4000

# Email (OTP verification and password reset)
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# AI. Every AI call goes through a fallback chain (see config/ai.js): Groq first, then Gemini models.
# Models over their daily limit (429) or retired (404) are skipped automatically; a provider with no key is skipped.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional overrides, comma-separated, best first. "groq:<model>" means a Groq model.
# AI_MODELS=groq:openai/gpt-oss-120b,gemini-2.5-flash-lite,gemini-3.5-flash
# AI_CV_MODELS=groq:openai/gpt-oss-120b,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash-lite
# Email is never sent outside production unless this is true (it is logged to the console instead)
# MAIL_IN_DEV=false
# Legacy provider switch for the interview service: gemini (default), huggingface or ollama
AI_PROVIDER=gemini
HF_API_TOKEN=
HF_MODEL_URL=
OLLAMA_API_URL=
OLLAMA_MODEL=

# Code execution. Choose a provider; if EXECUTION_PROVIDER is empty the first configured one is used.
# With no working provider, code execution is reported as unavailable and nothing is scored (never fake output).
# See infra/judge0/README.md for a local sandbox and hosted options.
EXECUTION_PROVIDER=
# Judge0 (self-hosted, judge0.com, or RapidAPI). Local example: http://127.0.0.1:2358
JUDGE0_URL=
# RapidAPI key or judge0.com auth token (optional for self-hosted)
JUDGE0_API_KEY=
# Only for RapidAPI, for example judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=
# Optional JSON override of Judge0 language ids, for example {"python":92}
JUDGE0_LANGUAGE_IDS=
# Backup provider: JDoodle
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

# Speech to text (AssemblyAI). If unset, transcription is reported as not configured.
ASSEMBLYAI_API_KEY=
